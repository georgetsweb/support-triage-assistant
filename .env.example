# Copy this file to .env and fill in your own values. .env is gitignored and never committed.
# Not needed until Session 3 (LLM classification and RAG).

# Which LLM to use: anthropic, openai or ollama (local, free)
LLM_PROVIDER=anthropic

# Only the key for the provider you chose is needed
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Only used when LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2
